# Copy to .env and fill in. Backend runs in mock (keyless) mode if OPENAI_API_KEY is empty.
# For Google Gemini (free tier): OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# and OPENAI_MODEL=gemini-2.0-flash with a key from https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Postgres (optional - falls back to local SQLite when unset)
DATABASE_URL=

# Redis (optional - falls back to in-memory agent memory when unset)
REDIS_URL=

# Where generated projects are executed (must be isolated from the repo)
WORKSPACE_ROOT=./workspaces

# Where agents direct their reasoning (dev, info, warning, error)
LOG_LEVEL=INFO

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Sandbox
EXECUTION_TIMEOUT=180
MAX_DEBUG_ATTEMPTS=3