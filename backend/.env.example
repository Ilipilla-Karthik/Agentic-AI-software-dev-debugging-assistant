# Leave OPENAI_API_KEY empty to run in free mock mode (full loop, deterministic demo).
# Set it to a real OpenAI key to enable live LLM generation + tool-calling debugging.
# For Google Gemini (free tier): set
#   OPENAI_API_KEY=your-gemini-key
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional Postgres/Redis (falls back to SQLite + in-memory when empty)
DATABASE_URL=
REDIS_URL=

WORKSPACE_ROOT=./workspaces
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
EXECUTION_TIMEOUT=180
MAX_DEBUG_ATTEMPTS=3